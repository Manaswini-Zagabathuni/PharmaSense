# Copy this file to .env and set both blank password values before starting
# Docker Compose. Compose rejects missing or empty passwords. Never commit .env.
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated hostnames only; production must set this explicitly and cannot use '*'.
APP_TRUSTED_HOSTS=localhost,127.0.0.1,api

MYSQL_DATABASE=pharmasense
MYSQL_USER=pharmasense
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Optional alternative to the MYSQL_* variables above. URL-encode credentials.
# DATABASE_URL=mysql+pymysql://user:password@host:3306/database

VITE_API_BASE_URL=/api/v1
# Vite development proxy target. Compose overrides this with http://api:8000.
VITE_API_PROXY_TARGET=http://localhost:8000
